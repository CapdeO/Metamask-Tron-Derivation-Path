# Option A: seed phrase (12/24 words separated by single spaces)
MNEMONIC=""

# Optional BIP39 passphrase (the "25th word"). Leave empty if you don't use one.
PASSPHRASE=""

# How many addresses to print (to find the one that matches MetaMask)
SCAN=5

# Option B: private key exported from MetaMask (64 hex chars). If set, it takes
# precedence and MNEMONIC/PASSPHRASE are ignored.
PRIVATE_KEY=""

# --- send-usdt.js ---
# Destination address for the USDT transfer (the amount is fixed in MONTO_USDT in the script).
TO_ADDRESS=""

# Index of the source account (the number read-balances.js printed with SCAN). Ignored if PRIVATE_KEY is set.
ADDRESS_INDEX=0

# TronGrid API key (optional, free at https://www.trongrid.io/dashboard).
# Without a key the public endpoint rate-limits bursts and scanning gets slow.
TRONGRID_API_KEY=""

# Alternative node (e.g. Nile testnet: https://nile.trongrid.io)
# TRONGRID_URL="https://api.trongrid.io"
# On Nile you also need to change the USDT contract (verify it on nile.tronscan.org):
# USDT_CONTRACT="TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf"
